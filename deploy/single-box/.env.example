# Nexora single-box configuration.
#
#   cp .env.example .env    and fill in the marked values. Never commit .env.
#
# Only the lines marked >>> SET THIS <<< need a human. Everything else is correct as shipped.
#
# Generate secrets with:  openssl rand -base64 48
# EXCEPT Security__SecretProtectionKey, which is an AES-256 key and must decode to EXACTLY
# 32 bytes — the app refuses to start otherwise:  openssl rand -base64 32

# ── Host paths ──────────────────────────────────────────────────────────────────────────────
# Where source documents live. This is the document estate: it is content-addressed, never
# deleted by the application, and MUST be backed up. Losing it is unrecoverable.
EVIDENCE_PATH=/srv/nexora/evidence
# The built frontend (Frontend/dist after `npm run build`).
FRONTEND_DIST_PATH=/srv/nexora/web

# ── Database ────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=                        # >>> SET THIS <<<
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=nexora;Username=nexora;Password=CHANGEME
ConnectionStrings__MigrationConnection=Host=127.0.0.1;Port=5432;Database=nexora;Username=nexora;Password=CHANGEME
Database__ApplyMigrationsOnStartup=true

# ── Secrets ─────────────────────────────────────────────────────────────────────────────────
# Jwt__Key signs tenant tokens. Jwt__PlatformKey signs operator-console tokens — treat it as the
# most sensitive value here. Security__SecretProtectionKey encrypts stored mailbox credentials;
# rotating it invalidates them and they must be re-entered.
Jwt__Key=                                 # >>> SET THIS <<<
Jwt__PlatformKey=                         # >>> SET THIS <<<
Jwt__Issuer=Nexora
Jwt__Audience=Nexora
Jwt__ExpiryMinutes=60
Security__SecretProtectionKey=            # >>> SET THIS <<<  (openssl rand -base64 32 — exactly 32 bytes)
CommercialFinance__AuditActorSecret=      # >>> SET THIS <<<
CommercialFinance__ContactVerificationSecret=   # >>> SET THIS <<<
CommercialFinance__DunningProviderWebhookSecret= # >>> SET THIS <<<

# ── AI: LOCAL, and that is the whole point ──────────────────────────────────────────────────
# Nexora classifies a provider as Local ONLY when the endpoint is loopback. A local endpoint
# needs no per-tenant authorization, sends no document text anywhere, and keeps every byte
# inside this machine. Do NOT change this to a hostname or a container service name — a
# non-loopback URL is classified External and unstructured extraction is refused outright.
Ollama__BaseUrl=http://127.0.0.1:11434
Ollama__Model=qwen2.5:14b-instruct
Ollama__ApiKey=
Ollama__MaxOutputTokens=8192

# ── Document security ───────────────────────────────────────────────────────────────────────
# ClamAV runs in the compose file. The BuiltIn alternative is a structural inspector that
# detects no actual malware, on a product whose primary input is customer documents.
DocumentInspection__Scanner__Provider=ClamAV
DocumentInspection__ClamAV__Host=127.0.0.1
DocumentInspection__ClamAV__Port=3310
DocumentInspection__ClamAV__Timeout=00:00:30

# ── Storage ─────────────────────────────────────────────────────────────────────────────────
EvidenceStorage__Provider=Local
Storage__RootPath=/var/data/nexora/uploads
Storage__RequiredMountPath=/var/data
Storage__EnforcePersistentMount=true

# ── Outbound email ──────────────────────────────────────────────────────────────────────────
# WITHOUT THIS, NOTHING IS SENT. The default "console" provider logs "Email NOT sent" and
# returns no receipt, so supplier RFQ dispatch lands in DeliveryFailed, customer quotes are
# never delivered, and follow-up reminders reach nobody. It fails honestly, but it fails.
Notifications__Provider=smtp
Notifications__Smtp__Host=smtpout.secureserver.net
Notifications__Smtp__Port=465
Notifications__Smtp__UseSsl=true
Notifications__Smtp__Username=zack@kodekinetics.com
Notifications__Smtp__Password=            # >>> SET THIS <<<  (app password, not the account password)
Notifications__FromAddress=zack@kodekinetics.com
Notifications__FromName=Nexora
Notifications__AppBaseUrl=http://localhost

# ── Inbound email (the RFQ intake channel) ──────────────────────────────────────────────────
# Google Workspace requires an APP PASSWORD, not the account password, and IMAP must be enabled
# in the mailbox settings. Configure the mailbox in the app under Setup → Mailboxes; these are
# the values to enter there.
#   Server imap.gmail.com   Port 993   SSL/TLS   User zahid@naspakinc.com
# The GoDaddy mailbox is imap.secureserver.net:993 with the same shape.

# ── Platform ────────────────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
Cors__AllowedOrigins__0=http://localhost
# Restrict the operator console to the machines that should reach it. "Any" leaves it open to
# every network that can route to the host.
PlatformAccess__NetworkMode=Cidr
PlatformAccess__AllowedCidrs__0=127.0.0.1/32
Observability__Prometheus__Enabled=false
