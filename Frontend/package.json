{
  "name": "rfq-automation-vite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-bundle-budget.mjs",
    "e2e": "playwright test",
    "e2e:acceptance": "E2E_FULL_ACCEPTANCE=true playwright test --config playwright.commercial-journey-v2.config.ts --workers=1 --retries=0",
    "e2e:list": "playwright test --list",
    "e2e:install": "playwright install chromium",
    "e2e:a11y": "playwright test --config playwright.a11y.config.ts",
    "lint": "eslint . --report-unused-disable-directives --quiet",
    "lint:a11y": "eslint . --report-unused-disable-directives",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-data-grid": "^9.0.4",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-query-devtools": "^5.100.8",
    "@types/lodash": "^4.17.24",
    "axios": "^1.16.0",
    "dayjs": "^1.11.20",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.14.0",
    "notistack": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.6",
    "react-router-dom": "7.18.2",
    "recharts": "^3.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  },
  "//overrides": "eslint-plugin-jsx-a11y@6.10.2 (latest as of 2026-08) still declares peer eslint '^3 || ... || ^9' while this project is on eslint 10. The plugin is flat-config native and runs correctly on 10, so its eslint peer is pinned to the root version. Without this, `npm ci` fails with ERESOLVE. REMOVE this override once jsx-a11y ships a release with an eslint ^10 peer range.",
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
