<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ERP_RFQ_Automation\ERP_RFQ_Automation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\legacy-rfq.xls" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\unrecognized-layout-rfq.xls" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\recognized-layout-rfq.xls" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\empty-workbook.xls" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\rfq-table.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\rfq-table-2.docx" CopyToOutputDirectory="PreserveNewest" />
    <!-- The representative RFQ corpus: committed binaries + the manifest that defines every
         expected classification and extracted value in advance. See Corpus\README.md. -->
    <Content Include="Corpus\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
