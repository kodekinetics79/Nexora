{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=__DB_SERVER__;Database=__DB_NAME__;User Id=__DB_USER__;Password=__DB_PASSWORD__;TrustServerCertificate=True;"
    },
    "Security": {
        "SecretProtectionKey": "__SECRET_PROTECTION_KEY__"
    },
    "Jwt": {
        "Key": "__JWT_SIGNING_KEY__",
        "Issuer": "KodeKinetics",
        "Audience": "RFQ",
        "ExpiryMinutes": 60
    },
    "Ingestion": {
        "UseUnifiedQueue": true
    },
    "CommercialFinance": {
        "OutboxDispatcher": {
            "Enabled": false,
            "Endpoint": "",
            "HmacSecret": ""
        }
    },
    "Ollama": {
        "BaseUrl": "https://ollama.com/",
        "ApiKey": "__OLLAMA_API_KEY__",
        "Model": "deepseek-v4-pro",
        "//MaxOutputTokens": "num_predict per call. Was UNSET, which silently meant 4096 and capped extraction at ~5 line items per chunk. 8192 is the largest value we have observed this model complete within the 180s client timeout (measured live 2026-08-05); the provider itself allows up to 65536. Raise it only alongside a measured generation-throughput number, or the truncation outage becomes a timeout outage.",
        "MaxOutputTokens": 8192
    },
    "Notifications": {
        "Provider": "console",
        "FromAddress": "no-reply@nexora.app",
        "FromName": "Nexora",
        "ReplyToAddress": "",
        "AppBaseUrl": "https://nexora1-ai.vercel.app",
        "Smtp": {
            "Host": "",
            "Port": 587,
            "Username": "",
            "Password": "",
            "EnableSsl": true,
            "TimeoutMs": 30000
        },
        "SendGrid": {
            "ApiKey": "",
            "ApiBaseUrl": "https://api.sendgrid.com"
        }
    },
    "Observability": {
        "OtlpEndpoint": "",
        "ServiceVersion": "1.0.0",
        "Environment": "Production"
    },
    "RateLimiting": {
        "PermitLimit": 600,
        "WindowSeconds": 60,
        "QueueLimit": 0,
        "Upload": {
            "PermitLimit": 30,
            "WindowSeconds": 60,
            "QueueLimit": 0
        }
    },
    "Agent": {
        "Anthropic": {
            "ApiKey": "",
            "Model": "claude-sonnet-5",
            "MaxTokens": 2048
        }
    }
}
