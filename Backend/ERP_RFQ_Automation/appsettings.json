{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=__DB_SERVER__;Database=__DB_NAME__;User Id=__DB_USER__;Password=__DB_PASSWORD__;TrustServerCertificate=True;"
    },
    "Jwt": {
        "Key": "__JWT_SIGNING_KEY__",
        "Issuer": "KodeKinetics",
        "Audience": "RFQ",
        "ExpiryMinutes": 60
    },
    "Ollama": {
        "BaseUrl": "https://ollama.com/",
        "ApiKey": "__OLLAMA_API_KEY__",
        "Model": "deepseek-v3.1:671b-cloud"
    },
    "Notifications": {
        "Provider": "console",
        "FromAddress": "no-reply@nexora.app",
        "FromName": "Nexora",
        "ReplyToAddress": "",
        "AppBaseUrl": "https://nexora-ai-beryl.vercel.app",
        "Smtp": {
            "Host": "",
            "Port": 587,
            "Username": "",
            "Password": "",
            "EnableSsl": true,
            "TimeoutMs": 30000
        },
        "SendGrid": {
            "ApiKey": "",
            "ApiBaseUrl": "https://api.sendgrid.com"
        }
    },
    "Observability": {
        "OtlpEndpoint": "",
        "ServiceVersion": "1.0.0",
        "Environment": "Production"
    },
    "RateLimiting": {
        "PermitLimit": 600,
        "WindowSeconds": 60,
        "QueueLimit": 0,
        "Upload": {
            "PermitLimit": 30,
            "WindowSeconds": 60,
            "QueueLimit": 0
        }
    }
}